---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { url } from '../lib/url';
import { cv, publications, linkedTools, publicationByDoi } from '../lib/cv';

const tools = linkedTools;
// Datasets are a curated list in cv.yaml, not derived from every publication with a
// replication package — see RESOURCES-CURATION.md for the criteria and what was excluded.
const datasets = cv.datasets;
---
<Base title="Resources" description={`Research software, datasets and replication packages from ${cv.name}'s work.`}>
  <PageHeader
    eyebrow="Resources"
    title="Resources"
    intro="Things from my work that are useful on their own: research software, and the datasets and replication packages behind the papers."
  />

  <div class="mx-auto max-w-[1180px] px-6 pb-16 md:px-12">
    {datasets.length > 0 && (
      <section class="pb-12">
        <h2 class="eyebrow border-b border-[--color-rule] pb-4">Datasets</h2>
        <p class="max-w-[720px] py-5 text-[17px] font-light leading-relaxed text-body">
          Data and catalogs from my studies that are useful on their own, not only for
          reproducing a result. Each one is cited in the paper it came from.
        </p>
        <ul class="grid items-start gap-5 md:grid-cols-2">
          {datasets.map((d) => (
            <li class="rounded border border-[--color-rule] bg-card p-6">
              <h3 class="text-xl font-semibold tracking-tight">
<a href={d.links[0]?.url} target="_blank" rel="noopener" class="text-ink no-underline hover:underline">{d.name}</a>
              </h3>
              <p class="pt-2 text-[17px] font-light leading-relaxed text-body">{d.description}</p>
              <p class="flex flex-wrap gap-x-4 gap-y-1 pt-3 font-sans text-[13px]">
                {d.links.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.label} →</a>)}
              </p>
              <ul class="flex flex-col gap-1 pt-2">
                {d.publications.map((doi) => {
                  const pub = publicationByDoi(doi);
                  return (
                    <li class="font-sans text-[13px] leading-snug">
                      <span class="text-muted">From: </span>
                      <a href={`https://doi.org/${doi}`} target="_blank" rel="noopener">{pub ? pub.title : doi}</a>
                      {pub && <span class="text-muted"> · {pub.venueShort ?? pub.venue} {pub.yearNum}</span>}
                    </li>
                  );
                })}
              </ul>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section>
      <h2 class="eyebrow border-b border-[--color-rule] pb-4">Research software</h2>
      <p class="max-w-[720px] py-5 text-[17px] font-light leading-relaxed text-body">
        Tools built for specific studies, each tied to the paper it came from. They are research
        prototypes rather than maintained products — useful to read, reuse or build on, but none
        of them is a supported release.
      </p>
      <ul class="grid items-start gap-5 md:grid-cols-2">
        {tools.map((t) => (
          <li class="rounded border border-[--color-rule] bg-card p-6">
            <h3 class="text-xl font-semibold tracking-tight">
              <a href={t.url} target="_blank" rel="noopener" class="text-ink no-underline hover:underline">{t.project}</a>
            </h3>
            <p class="pt-2 text-[17px] font-light leading-relaxed text-body">{t.description}</p>
            <p class="pt-3 font-sans text-[13px] text-muted">
              {t.language && <span class="rounded-sm border border-[--color-rule] px-2 py-0.5">{t.language}</span>}
              <a class="ml-3" href={t.url} target="_blank" rel="noopener">Source →</a>
            </p>
            <ul class="flex flex-col gap-1 pt-3">
              {t.publications.map((doi) => {
                const pub = publicationByDoi(doi);
                return (
                  <li class="font-sans text-[13px] leading-snug">
                    <span class="text-muted">From: </span>
                    <a href={`https://doi.org/${doi}`} target="_blank" rel="noopener">{pub ? pub.title : doi}</a>
                    {pub && <span class="text-muted"> · {pub.venueShort ?? pub.venue} {pub.yearNum}</span>}
                  </li>
                );
              })}
            </ul>
          </li>
        ))}
      </ul>
    </section>

    <p class="pt-10 font-sans text-[15px] text-muted">
      Looking for the papers themselves? <a href={url('/publications/')}>All {publications.length} publications →</a>
    </p>
  </div>
</Base>
