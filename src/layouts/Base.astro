---
import { url } from '../lib/url';
import '../styles/global.css';
import { cv } from '../lib/cv';

interface Props { title?: string; description?: string; }
const { title, description } = Astro.props;

// SEO: the <h1> is a slogan with no searchable noun, so the title and description carry
// the name and the field terms.
const pageTitle = title
  ? `${title} — ${cv.name}`
  : `${cv.name} — ${cv.label}, Software Engineering, University of Groningen`;
const pageDesc = description ?? (cv.site as any)?.description ?? cv.summary;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://feitosa-daniel.github.io');

const nav = [
  { href: '/', label: 'Research' },
  { href: '/publications/', label: 'Publications' },
  { href: '/resources/', label: 'Resources' },
  { href: '/teaching/', label: 'Teaching' },
  { href: '/supervision/', label: 'Supervision' },
  { href: '/service/', label: 'Service' },
];
const here = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? here === '/' : here.startsWith(href));

const links = [
  ['Scholar', 'Google Scholar'], ['DBLP', 'DBLP'], ['ORCID', 'ORCID'],
  ['GitHub', 'GitHub'], ['Mastodon', 'Mastodon'], ['LinkedIn', 'LinkedIn'],
] as const;
const linkFor = (net: string) => cv.profiles.find((p) => p.network === net)?.url;
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,300;8..60,400;8..60,600&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: cv.name,
      jobTitle: cv.label,
      email: `mailto:${cv.email}`,
      url: canonical.origin,
      affiliation: { '@type': 'Organization', name: 'University of Groningen' },
      sameAs: cv.profiles.map((p) => p.url),
    })} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:m-3 focus:p-2 focus:bg-white">Skip to content</a>

    <header class="border-b border-[--color-rule-soft]">
      <nav class="mx-auto flex max-w-[1180px] flex-wrap items-center justify-between gap-4 px-6 py-5 md:px-12" aria-label="Main">
        <a href={url('/')} class="font-sans text-[15px] font-bold tracking-tight text-ink no-underline hover:no-underline">{cv.name}</a>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 font-sans text-sm font-medium">
          {nav.map((n) => (
            <li>
              <a href={url(n.href)} aria-current={isActive(n.href) ? 'page' : undefined}
                 class={isActive(n.href) ? 'text-ink underline underline-offset-4' : ''}>{n.label}</a>
            </li>
          ))}
          <li><a href={url('/Feitosa-CV-Public.pdf')} target="_blank" rel="noopener">CV&nbsp;(PDF)</a></li>
        </ul>
      </nav>
    </header>

    <main id="main"><slot /></main>

    <footer class="mx-auto max-w-[1180px] px-6 pb-16 pt-14 md:px-12">
      <div class="flex flex-col gap-4 border-t border-[--color-rule-soft] pt-7 font-sans text-sm text-[#6E7370] md:flex-row md:items-center md:justify-between">
        <div>
          <a href={`mailto:${cv.email}`}>{cv.email}</a>
          <span class="mx-2">·</span>{cv.location.city}, {cv.location.region}
        </div>
        <div class="flex flex-wrap gap-x-5 gap-y-2">
          {links.map(([label, net]) => {
            const href = linkFor(net);
            return href ? <a href={href} target="_blank" rel="me noopener">{label}</a> : null;
          })}
          <a href={url('/Feitosa-CV-Public.pdf')} target="_blank" rel="noopener">CV (PDF)</a>
        </div>
      </div>
    </footer>
  </body>
</html>
