---
interface Props { eyebrow?: string; title: string; intro?: string; }
const { eyebrow, title, intro } = Astro.props;
---
<div class="mx-auto max-w-[1180px] px-6 pb-10 pt-14 md:px-12">
  {eyebrow && <p class="eyebrow pb-4">{eyebrow}</p>}
  <h1 class="max-w-[820px] text-4xl font-semibold leading-tight tracking-tight md:text-5xl">{title}</h1>
  {intro && <p class="max-w-[660px] pt-5 text-lg font-light leading-relaxed text-body md:text-xl">{intro}</p>}
</div>
